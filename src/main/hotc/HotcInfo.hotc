// The first real, Gradle-COMPILED HotChocolate source in this mod -- as opposed to `hotc/model/`'s
// own standalone pilot files (compiled/run by hand, one at a time, each with its own `fn main()`
// for manual testing). No `main()` here on purpose: this is a LIBRARY unit meant to be referenced
// from real Java code, not a standalone runnable program by itself.
//
// Real package-qualification now: HotChocolate's own module-porting feature (see its
// `selfhost/codegen/Codegen.hotc`) turns this `module` declaration into a genuine
// `net/phoenixvine/chronicles/HotcInfo.class`, so Java code in a NAMED package (not just a
// default-package probe) can import and reference this normally.
module net.phoenixvine.chronicles;

struct HotcInfo {
    version: String,
}

impl HotcInfo {
    static fn current() -> HotcInfo {
        return HotcInfo { version: "0.1.0-hotc" };
    }

    fn describe(&self) -> String {
        return "Phoenix Chronicles hotc layer v" + self.version;
    }
}
